---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const grades = ['7', '8', '9'];
const classNumbers = Array.from({ length: 10 }, (_, i) => String(i + 1).padStart(2, '0'));
---

<BaseLayout title="選擇班級">
  <h1>選擇你的班級</h1>
  <p>
    選擇後,講義與公告列表會優先顯示跟你的班級相關的內容。這只是方便篩選,<strong>不是登入或存取限制</strong>——所有內容本來就是公開的,選錯或不選都不會有任何問題。
  </p>

  <form class="class-picker" data-class-form>
    <label>
      年級
      <select name="grade" required>
        <option value="" disabled selected>請選擇</option>
        {grades.map((g) => <option value={g}>{g} 年級</option>)}
      </select>
    </label>
    <label>
      班級
      <select name="cls" required>
        <option value="" disabled selected>請選擇</option>
        {classNumbers.map((c) => <option value={c}>{Number(c)} 班</option>)}
      </select>
    </label>
    <button type="submit">儲存並回首頁</button>
  </form>

  <p><button type="button" data-clear-selection>清除已選的班級(顯示全部內容)</button></p>
</BaseLayout>

<script>
  import { writeSelection, clearSelection } from '../scripts/classSelection.js';

  const base = import.meta.env.BASE_URL;
  const form = document.querySelector('[data-class-form]');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const grade = String(data.get('grade'));
    const cls = String(data.get('cls'));
    if (!grade || !cls) return;
    writeSelection(grade, cls);
    window.location.href = base;
  });

  document.querySelector('[data-clear-selection]')?.addEventListener('click', () => {
    clearSelection();
    window.location.href = base;
  });
</script>
