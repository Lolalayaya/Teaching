---
import '../../styles/global.css';
import config from '../../content/tech-time-machine.config.json';

const STEPS = config.levels;
const TOTAL_FRAGMENT_LENGTH = STEPS.reduce((sum, l) => sum + (l.fragment ? l.fragment.length : 0), 0);
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-Hant" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>科技生活時光機</title>
  </head>
  <body class="mission">
    <div class="stage" data-stage>
      <button type="button" class="reset-btn" data-reset-btn title="重新開始" aria-label="重新開始這個任務">⟲</button>

      <div class="progress-banner" data-progress-banner aria-live="polite" aria-label="任務進度">
        {Array.from({ length: TOTAL_FRAGMENT_LENGTH }).map((_, i) => (
          <span class="cipher-char" data-idx={i}>_</span>
        ))}
        <span class="cursor" aria-hidden="true">▍</span>
      </div>

      <section class="panel intro-panel" data-intro-screen>
        <h1>科技生活時光機</h1>
        <p>穿梭過去、現在、未來，看看資訊科技怎麼一步步改變食衣住行育樂。搭上時光機，蒐集每一站的線索片段，最後填一份小問卷結案。</p>
        <button type="button" class="primary-btn" data-start-btn>啟動時光機</button>
      </section>

      {STEPS.map((level, i) => (
        <section class="panel level-card" data-level-index={i} hidden>
          <p class="level-index">第 {i + 1} 站／共 {STEPS.length} 站</p>
          <h2>{level.title}</h2>
          <p class="prompt">{level.prompt}</p>

          <div class="answer-area" data-answer-area>
            {level.type === 'match' && (
              <div class="match-list">
                {level.pairs.map((pair) => (
                  <label class="match-row">
                    <span>{pair.left}</span>
                    <select data-match-left={pair.left}>
                      <option value="">請選擇</option>
                      {pair.options.map((opt) => (
                        <option value={opt}>{opt}</option>
                      ))}
                    </select>
                  </label>
                ))}
              </div>
            )}

            {level.type === 'choice' && (
              <div class="choice-list" data-choice-group>
                {level.options.map((opt) => (
                  <button type="button" class="choice-btn" data-choice-option data-value={opt}>{opt}</button>
                ))}
              </div>
            )}
          </div>

          <p class="feedback" data-feedback aria-live="polite"></p>
          <button type="button" class="primary-btn" data-submit-btn>確認答案</button>
        </section>
      ))}

      <section class="panel form-gate-screen" data-form-gate-screen hidden>
        <h2>最後一站：小問卷</h2>
        <p>填完下面這份表單，就正式結案。</p>
        <figure class="embed">
          <div class="embed-frame">
            <iframe src={config.formUrl} title="科技生活時光機小測驗" loading="lazy"></iframe>
          </div>
          <p class="embed-fallback">
            嵌入畫面無法顯示？<a href={config.formUrl} target="_blank" rel="noopener">在新視窗開啟 →</a>
          </p>
        </figure>
        <button type="button" class="primary-btn" data-form-done-btn>我已經填完表單了，繼續</button>
      </section>

      <section class="panel finale-screen" data-finale-screen hidden>
        <div class="stamp-wrap">
          <div class="stamp">
            <span>任務</span>
            <span>完成</span>
          </div>
          <div class="stamp-glow"></div>
          <div class="stamp-impact"></div>
        </div>
        <div class="finale-text" data-finale-text hidden>
          <p class="finale-line">{config.finaleLine}</p>
        </div>
        <button type="button" class="primary-btn celebrate-btn" data-play-audio-btn hidden>播放慶祝音樂 🎉</button>
        <a class="recap-link" data-recap-link hidden href={`${base}lectures/week3-7-recap/`}>查看今日複習 →</a>
      </section>
    </div>

    <script>
      import '../../scripts/techTimeMachinePage.js';
    </script>
  </body>
</html>

<style>
  :global(html[data-theme='dark']) {
    color-scheme: dark;
  }

  .mission {
    margin: 0;
    min-height: 100dvh;
    background:
      radial-gradient(circle at 50% -10%, color-mix(in oklch, var(--color-accent) 18%, transparent) 0%, transparent 60%),
      var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-sans);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow-x: hidden;
  }

  .stage {
    position: relative;
    width: min(640px, 92vw);
    padding: 2.5rem 0;
  }

  .reset-btn {
    position: fixed;
    left: 14px;
    bottom: 14px;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: color-mix(in oklch, var(--color-paper-2) 70%, transparent);
    color: var(--color-muted);
    font-size: 1.1rem;
    line-height: 1;
    opacity: 0.35;
    cursor: pointer;
    transition: opacity 160ms var(--ease-out), transform 160ms var(--ease-out);
  }

  .reset-btn:hover,
  .reset-btn:focus-visible {
    opacity: 1;
  }

  .reset-btn:active {
    transform: scale(0.94);
  }

  .progress-banner {
    text-align: center;
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: clamp(0.95rem, 2.4vw, 1.25rem);
    letter-spacing: 0.04em;
    color: var(--color-accent-hover);
    margin-bottom: 1.75rem;
    word-break: break-all;
  }

  .cipher-char {
    display: inline-block;
    opacity: 0.3;
    transform: scale(0.85);
    transition: opacity 140ms var(--ease-out), transform 140ms var(--mission-ease-bounce);
  }

  .cipher-char.revealed {
    opacity: 1;
    transform: scale(1);
    color: var(--color-accent-hover);
  }

  .cursor {
    display: inline-block;
    margin-left: 2px;
    animation: cursor-blink 1s steps(2, jump-none) infinite;
  }

  .panel {
    background: var(--color-paper-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    padding: 2rem;
    text-align: center;
  }

  .panel h1,
  .panel h2 {
    margin-top: 0;
    letter-spacing: -0.01em;
  }

  .level-index {
    color: var(--color-muted);
    font-size: 0.85rem;
    margin: 0 0 0.5rem;
  }

  .prompt {
    line-height: 1.7;
    white-space: pre-line;
    text-align: left;
  }

  .level-card {
    transition: opacity 450ms var(--ease-out), transform 450ms var(--ease-out), filter 450ms var(--ease-out);
  }

  @starting-style {
    .level-card:not([hidden]) {
      opacity: 0;
      transform: translateY(12px) scale(0.96);
      filter: blur(6px);
    }
  }

  .level-card:not([hidden]) {
    opacity: 1;
    transform: none;
    filter: blur(0);
  }

  .answer-area {
    margin: 1.5rem 0;
  }

  .match-list {
    display: grid;
    gap: 0.75rem;
    text-align: left;
    max-width: 28rem;
    margin: 0 auto;
  }

  .match-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .match-row select {
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-input);
    color: var(--color-ink);
    padding: 0.5rem 0.6rem;
    font-family: inherit;
    font-size: 0.9rem;
    max-width: 18rem;
  }

  .choice-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
  }

  .choice-btn {
    border: 1px solid var(--color-border);
    background: var(--color-paper);
    color: var(--color-ink);
    border-radius: var(--radius-pill);
    padding: 0.55rem 1.1rem;
    font-family: inherit;
    font-size: 0.95rem;
    cursor: pointer;
    transition: background-color 140ms var(--ease-out), border-color 140ms var(--ease-out), transform 140ms var(--ease-out);
  }

  .choice-btn:active {
    transform: scale(0.96);
  }

  .choice-btn.selected {
    background: var(--color-accent-tint);
    border-color: var(--color-accent);
    color: var(--color-accent-hover);
  }

  .primary-btn {
    background: var(--color-accent);
    color: var(--color-paper);
    border: none;
    border-radius: var(--radius-pill);
    padding: 0.75rem 1.75rem;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 140ms var(--ease-out), transform 140ms var(--ease-out);
  }

  .primary-btn:hover {
    background: var(--color-accent-hover);
  }

  .primary-btn:active {
    transform: scale(0.97);
  }

  .feedback {
    min-height: 1.4em;
    font-size: 0.95rem;
  }

  .feedback.correct {
    color: var(--color-correct);
  }

  .feedback.wrong {
    color: var(--color-wrong);
  }

  .level-card.flash-correct {
    background: var(--color-correct-bg);
    transition: background-color 200ms var(--ease-out);
  }

  .level-card.shake {
    animation: shake-x 320ms var(--ease-in-out);
    background: var(--color-wrong-bg);
  }

  @keyframes shake-x {
    0%, 100% { transform: translateX(0); }
    20% { transform: translateX(-6px); }
    40% { transform: translateX(6px); }
    60% { transform: translateX(-4px); }
    80% { transform: translateX(4px); }
  }

  /* Form gate ---------------------------------------------------------- */

  .form-gate-screen[hidden] {
    display: none;
  }

  .embed {
    margin: 1.25rem 0;
  }

  .embed-frame {
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-input);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .embed-frame iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  .embed-fallback {
    font-size: 0.85rem;
    color: var(--color-muted);
    margin-top: 0.5rem;
  }

  .embed-fallback a {
    color: var(--color-accent-hover);
  }

  /* Finale ---------------------------------------------------------------- */

  .finale-screen[hidden] {
    display: none;
  }

  .finale-screen {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    min-height: 20rem;
    justify-content: center;
  }

  .celebrate-btn {
    font-size: 0.95rem;
  }

  .stamp-wrap {
    position: relative;
    width: 160px;
    height: 160px;
  }

  .stamp {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 4px solid var(--color-accent);
    color: var(--color-accent-hover);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: 0.1em;
    opacity: 0;
    transform-origin: 50% 50%;
    transform: rotate(-2deg) scale(5);
  }

  .finale-screen.stamped .stamp {
    animation: stamp-slam 480ms cubic-bezier(0.6, 0.04, 0.98, 0.335) forwards;
  }

  @keyframes stamp-slam {
    0% { opacity: 0; transform: rotate(-2deg) scale(5); }
    10% { opacity: 0.6; transform: rotate(-2deg) scale(5); }
    100% { opacity: 1; transform: rotate(-8deg) scale(1); }
  }

  .stamp-impact {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 3px solid var(--color-accent);
    opacity: 0;
    pointer-events: none;
  }

  .finale-screen.stamped .stamp-impact {
    animation: stamp-ring 460ms var(--ease-out) 480ms both;
  }

  @keyframes stamp-ring {
    0% { opacity: 0; transform: scale(0.8); }
    15% { opacity: 0.9; transform: scale(0.95); }
    100% { opacity: 0; transform: scale(1.6); }
  }

  .finale-screen.stamped .stamp-wrap {
    animation: stamp-thud 220ms var(--ease-in-out) 480ms;
  }

  @keyframes stamp-thud {
    0%, 100% { transform: translate(0, 0); }
    30% { transform: translate(-2px, 1px); }
    60% { transform: translate(2px, -1px); }
  }

  .stamp-glow {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in oklch, var(--color-accent) 55%, transparent) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 700ms var(--ease-out);
  }

  .finale-screen.stamped .stamp-glow {
    opacity: 1;
  }

  .finale-text {
    text-align: center;
    transition: opacity 400ms var(--ease-out), transform 400ms var(--ease-out);
  }

  @starting-style {
    .finale-text:not([hidden]) {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  .finale-text:not([hidden]) {
    opacity: 1;
    transform: none;
  }

  .finale-line {
    color: var(--color-muted);
  }

  .recap-link {
    color: var(--color-accent-hover);
    font-size: 0.9rem;
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: reduce) {
    .level-card,
    .cipher-char,
    .choice-btn,
    .primary-btn,
    .reset-btn,
    .finale-text {
      transition-duration: 60ms !important;
    }

    .level-card.shake {
      animation: none;
    }

    .finale-screen.stamped .stamp {
      animation: none;
      opacity: 1;
      transform: rotate(-8deg) scale(1);
      transition: opacity 200ms ease;
    }

    .stamp-wrap {
      animation: none;
    }

    .stamp-impact {
      display: none;
    }
  }

  /* Page-scoped easing exception: same "delight budget" carve-out used by
     the escape room's door finale — deliberately not added to tokens.css. */
  .stage {
    --mission-ease-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);
    --ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);
  }

  @keyframes cursor-blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }
</style>
