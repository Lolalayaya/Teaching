---
import '../../styles/global.css';
import config from '../../content/mission-2.config.json';

const STEPS = config.levels;
const TOTAL_FRAGMENT_LENGTH = STEPS.reduce((sum, l) => sum + (l.fragment ? l.fragment.length : 0), 0);
const base = import.meta.env.BASE_URL;

const CTRL_PUNCT_ROWS = [
  ['，', 'Ctrl + ,'],
  ['。', 'Ctrl + .'],
  ['、', "Ctrl + '"],
  ['；', 'Ctrl + ;'],
  ['：', 'Ctrl + Shift + ;'],
  ['？', 'Ctrl + Shift + /'],
  ['！', 'Ctrl + Shift + 1'],
];

const BACKTICK_PUNCT_ROWS = [
  ['，', '` + ,'],
  ['。', '` + .'],
  ['、', "` + '"],
  ['；', '` + ;'],
  ['：', '` + Shift + ;'],
  ['？', '` + Shift + /'],
  ['！', '` + Shift + 1'],
];

const FILENAME_FORMAT_ROWS = [
  ['班級', '年級（1、2、3 或 7、8、9）＋ 班級（01～12）', '701'],
  ['（底線）', 'Shift + － （數字 0 右邊的鍵）', '_'],
  ['座號', '01～30，請打正確座號', '05'],
  ['姓名', '2～4 個中文字，請打全名，不要打綽號', '王小明'],
  ['日期＋文字', '4 碼日期 + 後面至少要有「截圖」兩個字', '0907截圖任務'],
];
---

<!doctype html>
<html lang="zh-Hant" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>特務闖關 · 蒐證任務</title>
  </head>
  <body class:list={['mission', { 'paste-allowed': config.allowPaste }]}>
    <div class="stage" data-stage>
      <button type="button" class="reset-btn" data-reset-btn title="重新開始" aria-label="重新開始這個任務">⟲</button>

      <div class="progress-banner" data-progress-banner aria-live="polite" aria-label="任務進度">
        {Array.from({ length: TOTAL_FRAGMENT_LENGTH }).map((_, i) => (
          <span class="cipher-char" data-idx={i}>_</span>
        ))}
        <span class="cursor" aria-hidden="true">▍</span>
      </div>

      <section class="panel intro-panel" data-intro-screen>
        <h1>特務闖關・蒐證任務</h1>
        <p>你是這次行動的情報員，任務是在電腦教室裡蒐集標點、表情、截圖與歸檔這幾項情報技能。完成所有關卡、集滿情報片段，就能結案，把成果送往下一個基地。</p>
        <button type="button" class="primary-btn" data-start-btn>接受任務</button>
      </section>

      {STEPS.map((level, i) => (
        <section class="panel level-card" data-level-index={i} hidden>
          <p class="level-index">第 {i + 1} 關／共 {STEPS.length} 關</p>
          <h2>{level.title}</h2>
          <p class={`prompt ${level.type === 'text-exact-strict' ? 'no-copy' : ''}`}>{level.prompt}</p>

          <div class="answer-area" data-answer-area>
            {level.type === 'quote-exact' && (
              <p class="assigned-quote" data-quote-slot></p>
            )}

            {level.referenceTable === 'ctrlPunct' && (
              <div class="ref-table-wrap">
                <table class="ref-table punct-table">
                  <thead><tr><th>符號</th><th>快捷鍵</th></tr></thead>
                  <tbody>
                    {CTRL_PUNCT_ROWS.map(([symbol, combo]) => (
                      <tr><td>「{symbol}」</td><td>{combo}</td></tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}

            {level.referenceTable === 'backtickPunct' && (
              <div class="ref-table-wrap">
                <table class="ref-table punct-table">
                  <thead><tr><th>符號</th><th>快捷鍵</th></tr></thead>
                  <tbody>
                    {BACKTICK_PUNCT_ROWS.map(([symbol, combo]) => (
                      <tr><td>「{symbol}」</td><td>{combo}</td></tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}

            {level.type === 'choice-multi' && (
              <div class={`choice-list ${level.id === 1 ? 'mono-choices' : ''}`} data-choice-group>
                {level.options.map((opt) => (
                  <button type="button" class="choice-btn" data-choice-option data-value={opt}>{opt}</button>
                ))}
              </div>
            )}

            {level.type === 'choice' && (
              <div class="choice-list" data-choice-group>
                {level.options.map((opt) => (
                  <button type="button" class="choice-btn" data-choice-option data-value={opt}>{opt}</button>
                ))}
              </div>
            )}

            {(level.type === 'text-exact-strict' || level.type === 'quote-exact') && (
              <input type="text" class="text-input" data-text-input autocomplete="off" />
            )}

            {level.type === 'search-query' && (
              <input
                type="text"
                class="text-input search-input"
                data-text-input
                autocomplete="off"
                placeholder="輸入你的搜尋語法…"
              />
            )}

            {level.type === 'qr-paste' && (
              <div class="qr-area">
                <canvas class="qr-canvas" data-qr-canvas></canvas>
                <div class="paste-zone" data-paste-zone tabindex="0" contenteditable="true" spellcheck="false">
                  貼上截圖處（點這裡後按 Ctrl+V）
                </div>
                <p class="paste-status" data-paste-status></p>
              </div>
            )}

            {level.type === 'filename-upload' && (
              <div class="file-area">
                <div class="ref-table-wrap">
                  <table class="ref-table filename-table">
                    <thead><tr><th>段落</th><th>規則</th><th>範例</th></tr></thead>
                    <tbody>
                      {FILENAME_FORMAT_ROWS.map(([part, rule, example]) => (
                        <tr><td>{part}</td><td>{rule}</td><td>{example}</td></tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                {level.sampleFile && (
                  <a class="sample-link" href={`${base}${level.sampleFile}`} download>📎 下載範例檔案</a>
                )}
                <input type="file" class="file-input" data-file-input accept="image/png,image/jpeg" />
                <p class="file-status" data-file-status></p>
              </div>
            )}
          </div>

          <p class="feedback" data-feedback aria-live="polite"></p>
          <button type="button" class="primary-btn" data-submit-btn>確認答案</button>
        </section>
      ))}

      <section class="panel finale-screen" data-finale-screen hidden>
        <div class="stamp-wrap">
          <div class="stamp">
            <span>任務</span>
            <span>完成</span>
          </div>
          <div class="stamp-glow"></div>
          <div class="stamp-impact"></div>
        </div>
        <div class="finale-text" data-finale-text hidden>
          <p class="finale-line">{config.finaleLine}</p>
        </div>
        <button type="button" class="primary-btn celebrate-btn" data-play-audio-btn hidden>播放慶祝音樂 🎉</button>
        <div class="bridge-card" data-bridge-card hidden>
          <span class="bridge-icon" aria-hidden="true">🚀</span>
          <p>下一個基地，準備出發。</p>
        </div>
        <a class="recap-link" data-recap-link hidden href={`${base}lectures/unit02-recap/`}>查看今日複習 →</a>
      </section>
    </div>

    <script>
      import '../../scripts/mission2Page.js';
    </script>
  </body>
</html>

<style>
  :global(html[data-theme='dark']) {
    color-scheme: dark;
  }

  .mission {
    margin: 0;
    min-height: 100dvh;
    background:
      radial-gradient(circle at 50% -10%, color-mix(in oklch, var(--color-accent) 18%, transparent) 0%, transparent 60%),
      var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-sans);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow-x: hidden;
  }

  .stage {
    position: relative;
    width: min(640px, 92vw);
    padding: 2.5rem 0;
  }

  .reset-btn {
    position: fixed;
    left: 14px;
    bottom: 14px;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: color-mix(in oklch, var(--color-paper-2) 70%, transparent);
    color: var(--color-muted);
    font-size: 1.1rem;
    line-height: 1;
    opacity: 0.35;
    cursor: pointer;
    transition: opacity 160ms var(--ease-out), transform 160ms var(--ease-out);
  }

  .reset-btn:hover,
  .reset-btn:focus-visible {
    opacity: 1;
  }

  .reset-btn:active {
    transform: scale(0.94);
  }

  .progress-banner {
    text-align: center;
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: clamp(0.95rem, 2.4vw, 1.25rem);
    letter-spacing: 0.04em;
    color: var(--color-accent-hover);
    margin-bottom: 1.75rem;
    word-break: break-all;
  }

  .cipher-char {
    display: inline-block;
    opacity: 0.3;
    transform: scale(0.85);
    transition: opacity 140ms var(--ease-out), transform 140ms var(--mission-ease-bounce);
  }

  .cipher-char.revealed {
    opacity: 1;
    transform: scale(1);
    color: var(--color-accent-hover);
  }

  .cursor {
    display: inline-block;
    margin-left: 2px;
    animation: cursor-blink 1s steps(2, jump-none) infinite;
  }

  .panel {
    background: var(--color-paper-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    padding: 2rem;
    text-align: center;
  }

  .panel h1,
  .panel h2 {
    margin-top: 0;
    letter-spacing: -0.01em;
  }

  .level-index {
    color: var(--color-muted);
    font-size: 0.85rem;
    margin: 0 0 0.5rem;
  }

  .prompt {
    line-height: 1.7;
    white-space: pre-line;
    text-align: left;
  }

  .prompt.no-copy {
    user-select: none;
  }

  .level-card {
    transition: opacity 450ms var(--ease-out), transform 450ms var(--ease-out), filter 450ms var(--ease-out);
  }

  @starting-style {
    .level-card:not([hidden]) {
      opacity: 0;
      transform: translateY(12px) scale(0.96);
      filter: blur(6px);
    }
  }

  .level-card:not([hidden]) {
    opacity: 1;
    transform: none;
    filter: blur(0);
  }

  .answer-area {
    margin: 1.5rem 0;
  }

  .text-input {
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-input);
    color: var(--color-ink);
    padding: 0.6rem 0.8rem;
    font-family: inherit;
    font-size: 1rem;
    width: 100%;
    max-width: 26rem;
  }

  .search-input {
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
  }

  .assigned-quote {
    max-width: 26rem;
    margin: 0 auto 1rem;
    padding: 0.9rem 1.1rem;
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-input);
    font-size: 1.05rem;
    line-height: 1.8;
    user-select: none;
  }

  .paste-allowed .assigned-quote {
    user-select: text;
  }

  .ref-table-wrap {
    overflow-x: auto;
    margin: 0 auto 1rem;
    max-width: 100%;
  }

  .ref-table {
    margin: 0 auto;
    border-collapse: collapse;
    font-size: 0.85rem;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
  }

  .ref-table th,
  .ref-table td {
    border: 1px solid var(--color-border);
    padding: 0.3rem 0.6rem;
    text-align: center;
  }

  .ref-table th {
    color: var(--color-muted);
    font-weight: 600;
  }

  .filename-table td:nth-child(2) {
    text-align: left;
  }

  .choice-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
  }

  .choice-list.mono-choices .choice-btn {
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 1.15rem;
  }

  .choice-btn {
    border: 1px solid var(--color-border);
    background: var(--color-paper);
    color: var(--color-ink);
    border-radius: var(--radius-pill);
    padding: 0.55rem 1.1rem;
    font-family: inherit;
    font-size: 0.95rem;
    cursor: pointer;
    transition: background-color 140ms var(--ease-out), border-color 140ms var(--ease-out), transform 140ms var(--ease-out);
  }

  .choice-btn:active {
    transform: scale(0.96);
  }

  .choice-btn.selected {
    background: var(--color-accent-tint);
    border-color: var(--color-accent);
    color: var(--color-accent-hover);
  }

  .qr-area,
  .file-area {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .qr-canvas {
    border-radius: var(--radius-input);
    border: 1px solid var(--color-border);
    background: #fff;
    padding: 0.5rem;
  }

  .paste-zone {
    width: 100%;
    max-width: 22rem;
    min-height: 3.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0.75rem 1rem;
    border: 1.5px dashed var(--color-border);
    border-radius: var(--radius-input);
    color: var(--color-muted);
    background: var(--color-paper);
    cursor: text;
    transition: border-color 140ms var(--ease-out), color 140ms var(--ease-out);
  }

  .paste-zone:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-color: var(--color-accent);
  }

  .paste-status,
  .file-status {
    min-height: 1.4em;
    font-size: 0.88rem;
    color: var(--color-muted);
  }

  .paste-status.correct,
  .file-status.correct {
    color: var(--color-correct);
  }

  .paste-status.wrong,
  .file-status.wrong {
    color: var(--color-wrong);
  }

  .file-input {
    font-family: inherit;
    font-size: 0.9rem;
    color: var(--color-ink);
  }

  .sample-link {
    display: inline-block;
    color: var(--color-accent-hover);
    font-size: 0.9rem;
    text-decoration: underline;
  }

  .primary-btn {
    background: var(--color-accent);
    color: var(--color-paper);
    border: none;
    border-radius: var(--radius-pill);
    padding: 0.75rem 1.75rem;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 140ms var(--ease-out), transform 140ms var(--ease-out);
  }

  .primary-btn:hover {
    background: var(--color-accent-hover);
  }

  .primary-btn:active {
    transform: scale(0.97);
  }

  .feedback {
    min-height: 1.4em;
    font-size: 0.95rem;
  }

  .feedback.correct {
    color: var(--color-correct);
  }

  .feedback.wrong {
    color: var(--color-wrong);
  }

  .level-card.flash-correct {
    background: var(--color-correct-bg);
    transition: background-color 200ms var(--ease-out);
  }

  .level-card.shake {
    animation: shake-x 320ms var(--ease-in-out);
    background: var(--color-wrong-bg);
  }

  @keyframes shake-x {
    0%, 100% { transform: translateX(0); }
    20% { transform: translateX(-6px); }
    40% { transform: translateX(6px); }
    60% { transform: translateX(-4px); }
    80% { transform: translateX(4px); }
  }

  /* Finale ---------------------------------------------------------------- */

  .finale-screen[hidden] {
    display: none;
  }

  .finale-screen {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    min-height: 20rem;
    justify-content: center;
  }

  .celebrate-btn {
    font-size: 0.95rem;
  }

  .stamp-wrap {
    position: relative;
    width: 160px;
    height: 160px;
  }

  .stamp {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 4px solid var(--color-accent);
    color: var(--color-accent-hover);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: 0.1em;
    opacity: 0;
    transform-origin: 50% 50%;
    transform: rotate(-2deg) scale(5);
  }

  /* The classic "stamp effect" trick: appear already huge and half-visible
     (like the block is right up against the page), hold briefly, then slam
     down to its flat resting size/angle. Scale doing the work, not position —
     that's what actually reads as an impact rather than a drop-and-bounce. */
  .finale-screen.stamped .stamp {
    animation: stamp-slam 480ms cubic-bezier(0.6, 0.04, 0.98, 0.335) forwards;
  }

  @keyframes stamp-slam {
    0% { opacity: 0; transform: rotate(-2deg) scale(5); }
    10% { opacity: 0.6; transform: rotate(-2deg) scale(5); }
    100% { opacity: 1; transform: rotate(-8deg) scale(1); }
  }

  /* A brief expanding ring right as the stamp lands, timed to the animation
     duration above — the "ink hitting paper" beat. */
  .stamp-impact {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 3px solid var(--color-accent);
    opacity: 0;
    pointer-events: none;
  }

  .finale-screen.stamped .stamp-impact {
    animation: stamp-ring 460ms var(--ease-out) 480ms both;
  }

  @keyframes stamp-ring {
    0% { opacity: 0; transform: scale(0.8); }
    15% { opacity: 0.9; transform: scale(0.95); }
    100% { opacity: 0; transform: scale(1.6); }
  }

  /* A tiny 2px thud on the whole stamp, same delay as the ring. */
  .finale-screen.stamped .stamp-wrap {
    animation: stamp-thud 220ms var(--ease-in-out) 480ms;
  }

  @keyframes stamp-thud {
    0%, 100% { transform: translate(0, 0); }
    30% { transform: translate(-2px, 1px); }
    60% { transform: translate(2px, -1px); }
  }

  .stamp-glow {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in oklch, var(--color-accent) 55%, transparent) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 700ms var(--ease-out);
  }

  .finale-screen.stamped .stamp-glow {
    opacity: 1;
  }

  .finale-text {
    text-align: center;
    transition: opacity 400ms var(--ease-out), transform 400ms var(--ease-out);
  }

  @starting-style {
    .finale-text:not([hidden]) {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  .finale-text:not([hidden]) {
    opacity: 1;
    transform: none;
  }

  .finale-line {
    color: var(--color-muted);
  }

  .bridge-card {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    border: 1px solid var(--color-border);
    background: var(--color-paper);
    border-radius: var(--radius-card);
    padding: 0.9rem 1.3rem;
    transition: opacity 400ms var(--ease-out), transform 400ms var(--ease-out);
  }

  @starting-style {
    .bridge-card:not([hidden]) {
      opacity: 0;
      transform: translateY(10px) scale(0.96);
    }
  }

  .bridge-card:not([hidden]) {
    opacity: 1;
    transform: none;
  }

  .bridge-icon {
    font-size: 1.4rem;
  }

  .bridge-card p {
    margin: 0;
  }

  .recap-link {
    color: var(--color-accent-hover);
    font-size: 0.9rem;
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: reduce) {
    .level-card,
    .cipher-char,
    .choice-btn,
    .primary-btn,
    .reset-btn,
    .finale-text,
    .bridge-card {
      transition-duration: 60ms !important;
    }

    .level-card.shake {
      animation: none;
    }

    .finale-screen.stamped .stamp {
      animation: none;
      opacity: 1;
      transform: rotate(-8deg) scale(1);
      transition: opacity 200ms ease;
    }

    .stamp-wrap {
      animation: none;
    }

    .stamp-impact {
      display: none;
    }
  }

  /* Page-scoped easing exception: same "delight budget" carve-out used by
     the escape room's door finale — deliberately not added to tokens.css. */
  .stage {
    --mission-ease-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);
    --ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);
  }

  @keyframes cursor-blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }
</style>
