---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

const lectures = (await getCollection('lectures')).sort((a, b) => b.data.order - a.data.order);
const showcaseItems = (await getCollection('showcase')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const latestLectures = lectures.slice(0, 6);
const latestShowcase = showcaseItems.slice(0, 3);

const currentItems = lectures
  .filter((lecture) => lecture.data.current)
  .map((lecture) => {
    // `classes`(新一週限制存取) 或 `currentFor`(舊一週只釘選給延後班級)
    // 只要有其中一個設定,代表這張卡片不是釘給全年級看的——老師模式會同時
    // 看到好幾週的卡片(見 classSelection.js 的「沒選班級=老師模式,不過濾」),
    // 用這個標籤讓老師自己看首頁時知道「這張是只給哪些班看的」,而不是網站壞了。
    const restrictedTo =
      lecture.data.classes && lecture.data.classes.length > 0
        ? lecture.data.classes
        : lecture.data.currentFor && lecture.data.currentFor.length > 0
          ? lecture.data.currentFor
          : null;
    return {
      href: `${base}lectures/${lecture.id}/`,
      title: `${lecture.data.unit} · ${lecture.data.title}`,
      summary: lecture.data.summary,
      grades: lecture.data.grades,
      classes: lecture.data.classes,
      currentFor: lecture.data.currentFor,
      restrictedTo,
      published: lecture.data.published,
      unlock: lecture.data.unlock,
    };
  });
---

<BaseLayout title="首頁">
  <h1>柔雅老師的資訊柑仔店</h1>
  <p class="tagline">這裡收錄資訊科技課程的講義與同學們的作品，歡迎隨時進來逛逛、複習功課！</p>

  <p class="filter-notice" data-filter-notice hidden></p>

  {currentItems.length > 0 && (
    <div class="current-focus">
      <p class="eyebrow">本堂課 · 今日重點</p>
      <ul class="card-list">
        {currentItems.map((item) => (
          <li
            class="card"
            data-audience
            data-grades={(item.grades ?? []).join(',')}
            data-classes={(item.classes ?? []).join(',')}
            data-current-for={(item.currentFor ?? []).join(',')}
            data-published={item.published === false ? 'false' : 'true'}
            data-unlock-after={item.unlock?.after?.toISOString() ?? ''}
            data-unlock-key={item.unlock?.storageKey ?? ''}
          >
            <a href={item.href}>{item.title}</a>
            {item.restrictedTo && (
              <p class="meta"><span class="tag">僅：{item.restrictedTo.join('、')} 班</span></p>
            )}
            {item.summary && <p class="meta">{item.summary}</p>}
          </li>
        ))}
      </ul>
    </div>
  )}

  <h2>課程講義</h2>
  <ul class="card-list">
    {latestLectures.map((lecture) => (
      <li
        class="card"
        data-audience
        data-grades={(lecture.data.grades ?? []).join(',')}
        data-classes={(lecture.data.classes ?? []).join(',')}
        data-published={lecture.data.published === false ? 'false' : 'true'}
        data-unlock-after={lecture.data.unlock?.after?.toISOString() ?? ''}
        data-unlock-key={lecture.data.unlock?.storageKey ?? ''}
      >
        <a href={`${base}lectures/${lecture.id}/`}>{lecture.data.unit} · {lecture.data.title}</a>
        {lecture.data.summary && <p class="meta">{lecture.data.summary}</p>}
      </li>
    ))}
  </ul>

  <p><a href={`${base}lectures/`}>查看所有講義 →</a></p>

  <h2>學生作品展示</h2>
  {latestShowcase.length === 0 ? (
    <p class="meta">目前尚無內容，期待大家的作品出現在這邊！</p>
  ) : (
    <ul class="card-list">
      {latestShowcase.map((item) => (
        <li class="card">
          <a href={`${base}showcase/${item.id}/`}>{item.data.title}</a>
          {item.data.description && <p class="meta">{item.data.description}</p>}
        </li>
      ))}
    </ul>
  )}

  <p><a href={`${base}showcase/`}>查看所有學生作品 →</a></p>
</BaseLayout>

<script>
  import { applyClassFilter } from '../scripts/classSelection.js';
  applyClassFilter();
</script>
