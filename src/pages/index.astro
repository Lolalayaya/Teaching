---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

const lectures = (await getCollection('lectures')).sort((a, b) => a.data.order - b.data.order);
const announcements = (await getCollection('announcements')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const showcaseItems = (await getCollection('showcase')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const latestLectures = lectures.slice(0, 6);
const latestAnnouncements = announcements.slice(0, 6);
const latestShowcase = showcaseItems.slice(0, 3);

const currentItems = [
  ...lectures
    .filter((lecture) => lecture.data.current)
    .map((lecture) => ({
      href: `${base}lectures/${lecture.id}/`,
      title: `${lecture.data.unit} · ${lecture.data.title}`,
      summary: lecture.data.summary,
      grades: lecture.data.grades,
      classes: lecture.data.classes,
    })),
  ...announcements
    .filter((post) => post.data.current)
    .map((post) => ({
      href: `${base}announcements/${post.id}/`,
      title: post.data.title,
      summary: undefined,
      grades: post.data.grades,
      classes: post.data.classes,
    })),
];
---

<BaseLayout title="首頁">
  <h1>Lola 的資訊柑仔店</h1>
  <p class="tagline">這裡收錄本學期資訊科技課程的講義、課程公告與學生作品,歡迎隨時晃進來逛逛、複習功課!</p>

  <p class="filter-notice" data-filter-notice hidden></p>

  {currentItems.length > 0 && (
    <div class="current-focus">
      <p class="eyebrow">本堂課 · 今日重點</p>
      <ul class="card-list">
        {currentItems.map((item) => (
          <li
            class="card"
            data-audience
            data-grades={(item.grades ?? []).join(',')}
            data-classes={(item.classes ?? []).join(',')}
          >
            <a href={item.href}>{item.title}</a>
            {item.summary && <p class="meta">{item.summary}</p>}
          </li>
        ))}
      </ul>
    </div>
  )}

  <h2>最新公告</h2>
  <ul class="card-list">
    {latestAnnouncements.map((post) => (
      <li
        class="card"
        data-audience
        data-grades={(post.data.grades ?? []).join(',')}
        data-classes={(post.data.classes ?? []).join(',')}
      >
        <a href={`${base}announcements/${post.id}/`}>{post.data.title}</a>
        <p class="meta">
          <span class="tag">{post.data.category}</span>
          {post.data.date.toLocaleDateString('zh-TW')}
        </p>
      </li>
    ))}
  </ul>

  <h2>課程講義</h2>
  <ul class="card-list">
    {latestLectures.map((lecture) => (
      <li
        class="card"
        data-audience
        data-grades={(lecture.data.grades ?? []).join(',')}
        data-classes={(lecture.data.classes ?? []).join(',')}
      >
        <a href={`${base}lectures/${lecture.id}/`}>{lecture.data.unit} · {lecture.data.title}</a>
        {lecture.data.summary && <p class="meta">{lecture.data.summary}</p>}
      </li>
    ))}
  </ul>

  <p><a href={`${base}lectures/`}>查看所有講義 →</a></p>

  <h2>學生作品展示</h2>
  <ul class="card-list">
    {latestShowcase.map((item) => (
      <li class="card">
        <a href={`${base}showcase/${item.id}/`}>{item.data.title}</a>
        {item.data.description && <p class="meta">{item.data.description}</p>}
      </li>
    ))}
  </ul>

  <p><a href={`${base}showcase/`}>查看所有學生作品 →</a></p>
</BaseLayout>

<script>
  import { applyClassFilter } from '../scripts/classSelection.js';
  applyClassFilter();
</script>
