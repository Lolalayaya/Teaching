---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Embed from '../../components/Embed.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const lectures = await getCollection('lectures');
  return lectures.map((lecture) => ({
    params: { slug: lecture.id },
    props: { lecture },
  }));
}

interface Props {
  lecture: CollectionEntry<'lectures'>;
}

const { lecture } = Astro.props;
const { Content } = await render(lecture);
const unlock = lecture.data.unlock;
const isUnpublished = lecture.data.published === false;
// `classes` here means "only these classes should see this yet" (e.g. a
// class that's delayed by a holiday shouldn't be able to open next week's
// page/homework early) — distinct from `currentFor`, which only narrows the
// homepage pinned box. Locked by default (same safe-default pattern as the
// publish gate below); initAudienceGate() in audienceGate.js unlocks it
// client-side if the viewer's stored class matches, or in teacher mode.
const audienceClasses = lecture.data.classes ?? [];
const hasAudienceGate = !isUnpublished && audienceClasses.length > 0;
---

<BaseLayout title={lecture.data.title} description={lecture.data.summary}>
  <p class="meta">{lecture.data.unit}</p>
  <h1>{lecture.data.title}</h1>

  {isUnpublished ? (
    <div data-publish-gate>
      <div class="locked-notice" data-publish-locked>
        <p>🔒 這份內容還沒公開，請等老師公告後再回來查看。</p>
      </div>
      <div data-publish-content hidden>
        <Content />
        {lecture.data.embeds?.map((embed) => (
          <Embed type={embed.type} title={embed.title} url={embed.url} />
        ))}
      </div>
    </div>
  ) : hasAudienceGate ? (
    <div data-audience-gate data-audience-classes={audienceClasses.join(',')}>
      <div class="locked-notice" data-audience-locked>
        <p>🔒 這份內容還沒輪到你的班級，等老師說可以開始了再回來看。</p>
      </div>
      <div data-audience-content hidden>
        <Content />
        {lecture.data.embeds?.map((embed) => (
          <Embed type={embed.type} title={embed.title} url={embed.url} />
        ))}
      </div>
    </div>
  ) : unlock ? (
    <div
      class="unlock-wrapper"
      data-unlock-wrapper
      data-unlock-after={unlock.after?.toISOString() ?? ''}
      data-unlock-key={unlock.storageKey ?? ''}
    >
      <div class="locked-notice" data-locked-notice>
        <p>{unlock.message ?? '🔒 這份內容會在你完成挑戰後自動解鎖。'}</p>
      </div>
      <div data-locked-content hidden>
        <Content />
        {lecture.data.embeds?.map((embed) => (
          <Embed type={embed.type} title={embed.title} url={embed.url} />
        ))}
      </div>
    </div>
  ) : (
    <>
      <Content />
      {lecture.data.embeds?.map((embed) => (
        <Embed type={embed.type} title={embed.title} url={embed.url} />
      ))}
    </>
  )}
</BaseLayout>

<script>
  import { initPublishGate } from '../../scripts/publishGate.js';
  import { initAudienceGate } from '../../scripts/audienceGate.js';
  initPublishGate();
  initAudienceGate();

  document.querySelectorAll('[data-unlock-wrapper]').forEach((wrapper) => {
    const el = wrapper as HTMLElement;
    const afterStr = el.dataset.unlockAfter;
    const key = el.dataset.unlockKey;

    const dateOk = Boolean(afterStr) && new Date() >= new Date(afterStr as string);
    const keyOk = Boolean(key) && Boolean(localStorage.getItem(key as string));

    if (dateOk || keyOk) {
      const notice = el.querySelector('[data-locked-notice]');
      const content = el.querySelector('[data-locked-content]');
      if (notice) (notice as HTMLElement).hidden = true;
      if (content) (content as HTMLElement).hidden = false;
    }
  });
</script>

<style>
  .locked-notice {
    background: var(--color-paper-2);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-card);
    padding: 1.5rem;
    text-align: center;
    color: var(--color-muted);
  }
</style>
