---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const lectures = (await getCollection('lectures')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="課程講義">
  <h1>課程講義</h1>
  <p class="filter-notice" data-filter-notice hidden></p>
  <ul class="card-list">
    {lectures.map((lecture) => (
      <li
        class="card"
        data-audience
        data-grades={(lecture.data.grades ?? []).join(',')}
        data-classes={(lecture.data.classes ?? []).join(',')}
        data-published={lecture.data.published === false ? 'false' : 'true'}
        data-unlock-after={lecture.data.unlock?.after?.toISOString() ?? ''}
        data-unlock-key={lecture.data.unlock?.storageKey ?? ''}
      >
        <a href={`${base}lectures/${lecture.id}/`}>{lecture.data.unit} · {lecture.data.title}</a>
        {lecture.data.summary && <p class="meta">{lecture.data.summary}</p>}
        <p class="meta">
          {lecture.data.semester && <span class="tag">{lecture.data.semester}</span>}
          {lecture.data.tags?.map((tag) => <span class="tag">{tag}</span>)}
        </p>
      </li>
    ))}
  </ul>
</BaseLayout>

<script>
  import { applyClassFilter } from '../../scripts/classSelection.js';
  applyClassFilter();
</script>
