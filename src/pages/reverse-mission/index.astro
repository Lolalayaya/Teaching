---
import '../../styles/global.css';
import config from '../../content/reverse-mission.config.json';

// Each level type has its own fields, so the JSON's inferred union type has
// no common shape to narrow on — treat levels as loosely typed here.
const STEPS: any[] = config.levels;
const TOTAL_FRAGMENT_LENGTH = STEPS.reduce((sum, l) => sum + (l.fragment ? l.fragment.length : 0), 0);
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-Hant" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>反轉行動 · 解碼任務</title>
  </head>
  <body class="mission">
    <div class="stage" data-stage>
      <button type="button" class="reset-btn" data-reset-btn title="重新開始" aria-label="重新開始這個任務">⟲</button>

      <div class="progress-banner" data-progress-banner aria-live="polite" aria-label="任務進度">
        {Array.from({ length: TOTAL_FRAGMENT_LENGTH }).map((_, i) => (
          <span class="cipher-char" data-idx={i}>_</span>
        ))}
        <span class="cursor" aria-hidden="true">▍</span>
      </div>

      <section class="panel intro-panel" data-intro-screen>
        <h1>反轉行動・解碼任務</h1>
        <p class="intro-text">這次換電腦出題、你來猜。寫程式前，先闖8關把遊戲想清楚。</p>
        <button type="button" class="primary-btn" data-start-btn>開始任務</button>
      </section>

      {STEPS.map((level, i) => (
        <section class="panel level-card" data-level-index={i} hidden>
          <p class="level-index">{level.stage}｜第 {i + 1} 關／共 {STEPS.length} 關</p>
          <h2>{level.title}</h2>
          <p class="prompt">{level.prompt}</p>

          <div class="answer-area" data-answer-area>
            {level.type === 'classify' && (
              <div class="classify-list">
                {level.items.map((item, itemIndex) => (
                  <div class="classify-row" data-classify-row={itemIndex}>
                    <p class="classify-text">{item.text}</p>
                    <div class="bin-group" role="group" aria-label={item.text}>
                      {level.bins.map((bin, binIndex) => (
                        <button type="button" class="bin-btn" data-bin={binIndex}>{bin}</button>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            )}

            {level.type === 'choice-multi' && (
              <div class="choice-list stacked" data-choice-group>
                {level.options.map((opt) => (
                  <button type="button" class="choice-btn" data-choice-option data-value={opt}>{opt}</button>
                ))}
              </div>
            )}

            {level.type === 'order' && (
              <div class="order-area">
                <pre class="code-block">{level.codeBefore}</pre>
                <ol class="order-slots" data-order-slots>
                  <li class="order-empty" data-order-empty>（點選下面的積木，排進迴圈裡）</li>
                </ol>
                <pre class="code-block">{level.codeAfter}</pre>
                <p class="pool-label">可以使用的積木</p>
                <div class="order-pool" data-order-pool>
                  {level.items.map((item) => (
                    <button type="button" class="block-btn" data-order-item={item.id}>{item.text}</button>
                  ))}
                </div>
              </div>
            )}

            {level.type === 'trace' && (
              <div class="table-wrap">
                <table class="trace-table">
                  <thead>
                    <tr><th>第幾次</th><th>玩家猜</th><th>電腦說</th><th>「次數」</th></tr>
                  </thead>
                  <tbody>
                    {level.rows.map((row, rowIndex) => (
                      <tr data-trace-row={rowIndex}>
                        <td>{rowIndex + 1}</td>
                        <td>{row.guess}</td>
                        <td>
                          <select class="trace-select" data-trace-hint aria-label={`第${rowIndex + 1}次電腦說`}>
                            <option value="">請選擇</option>
                            {level.hintOptions.map((opt) => (
                              <option value={opt}>{opt}</option>
                            ))}
                          </select>
                        </td>
                        <td>
                          <input type="text" inputmode="numeric" class="text-input number-input" data-trace-count aria-label={`第${rowIndex + 1}次的次數`} autocomplete="off" />
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}

            {level.type === 'quiz' && (
              <div class="quiz-area">
                {level.widget === 'race' && (
                  <div class="race" data-race>
                    <div class="race-controls">
                      <label>
                        答案
                        <input type="text" inputmode="numeric" class="text-input number-input" data-race-input value="73" autocomplete="off" />
                      </label>
                      <button type="button" class="choice-btn" data-race-random>隨機一個</button>
                      <button type="button" class="primary-btn small" data-race-start>開始比賽</button>
                    </div>
                    <p class="race-status" data-race-status aria-live="polite"></p>
                    <div class="race-lanes" data-race-lanes></div>
                  </div>
                )}

                {level.table && (
                  <div class="table-wrap">
                    <table class="ref-table">
                      <thead>
                        <tr>{level.table.head.map((h) => <th>{h}</th>)}</tr>
                      </thead>
                      <tbody>
                        {level.table.rows.map((row) => (
                          <tr>{row.map((cell) => <td>{cell}</td>)}</tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}

                {level.questions.map((q, qIndex) => (
                  <div class="question" data-question={qIndex}>
                    <p class="question-prompt"><span class="question-no">{qIndex + 1}.</span>{q.prompt}</p>
                    {q.code && <pre class="code-block">{q.code}</pre>}
                    {q.kind === 'choice' && (
                      <div class="choice-list stacked" data-choice-group>
                        {q.options.map((opt) => (
                          <button type="button" class="choice-btn" data-choice-option data-value={opt}>{opt}</button>
                        ))}
                      </div>
                    )}
                    {q.kind === 'number' && (
                      <input type="text" inputmode="numeric" class="text-input number-input" data-number-input autocomplete="off" placeholder="輸入數字" />
                    )}
                  </div>
                ))}
              </div>
            )}
          </div>

          <p class="feedback" data-feedback aria-live="polite"></p>
          <button type="button" class="primary-btn" data-submit-btn>確認答案</button>
        </section>
      ))}

      <section class="panel finale-screen" data-finale-screen hidden>
        <div class="stamp-wrap">
          <div class="stamp">
            <span>任務</span>
            <span>完成</span>
          </div>
          <div class="stamp-glow"></div>
          <div class="stamp-impact"></div>
        </div>
        <div class="finale-text" data-finale-text hidden>
          <p class="finale-line">{config.finaleLine}</p>
          <p class="finale-hint">請舉手讓老師確認這個畫面。</p>
        </div>
        <button type="button" class="primary-btn celebrate-btn" data-play-audio-btn hidden>播放慶祝音樂 🎉</button>
        <a class="recap-link" data-recap-link hidden href={`${base}lectures/week11-8-recap/`}>查看本週重點統整 →</a>
      </section>
    </div>

    <script>
      import '../../scripts/reverseMissionPage.js';
    </script>
  </body>
</html>

<style>
  :global(html[data-theme='dark']) {
    color-scheme: dark;
  }

  .mission {
    margin: 0;
    min-height: 100dvh;
    background:
      radial-gradient(circle at 50% -10%, color-mix(in oklch, var(--color-accent) 18%, transparent) 0%, transparent 60%),
      var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-sans);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow-x: hidden;
  }

  .stage {
    position: relative;
    width: min(720px, calc(100vw - 32px));
    padding: 2.5rem 0;
    --mission-ease-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);
    --ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);
  }

  .reset-btn {
    position: fixed;
    left: 14px;
    bottom: 14px;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: color-mix(in oklch, var(--color-paper-2) 70%, transparent);
    color: var(--color-muted);
    font-size: 1.1rem;
    line-height: 1;
    opacity: 0.35;
    cursor: pointer;
    transition: opacity 160ms var(--ease-out);
  }

  .reset-btn:hover,
  .reset-btn:focus-visible {
    opacity: 1;
  }

  .progress-banner {
    text-align: center;
    font-size: clamp(0.95rem, 2.4vw, 1.25rem);
    letter-spacing: 0.04em;
    color: var(--color-accent-hover);
    margin-bottom: 1.75rem;
    word-break: break-all;
  }

  .cipher-char {
    display: inline-block;
    opacity: 0.3;
    transform: scale(0.85);
    transition: opacity 140ms var(--ease-out), transform 140ms var(--mission-ease-bounce);
  }

  .cipher-char.revealed {
    opacity: 1;
    transform: scale(1);
  }

  .cursor {
    display: inline-block;
    margin-left: 2px;
    animation: cursor-blink 1s steps(2, jump-none) infinite;
  }

  .panel {
    background: var(--color-paper-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    padding: clamp(1.25rem, 4vw, 2rem);
    text-align: center;
  }

  .panel h1,
  .panel h2 {
    margin-top: 0;
    letter-spacing: -0.01em;
  }

  .intro-text {
    text-align: left;
    line-height: 1.8;
  }

  .level-index {
    color: var(--color-muted);
    font-size: 0.85rem;
    margin: 0 0 0.5rem;
  }

  .prompt {
    line-height: 1.8;
    white-space: pre-line;
    text-align: left;
  }

  .level-card {
    transition: opacity 450ms var(--ease-out), transform 450ms var(--ease-out), filter 450ms var(--ease-out);
  }

  @starting-style {
    .level-card:not([hidden]) {
      opacity: 0;
      transform: translateY(12px) scale(0.96);
      filter: blur(6px);
    }
  }

  .answer-area {
    margin: 1.5rem 0;
    text-align: left;
  }

  /* Code listings (pseudo-Scratch blocks) ---------------------------------- */

  .code-block {
    margin: 0.5rem 0;
    padding: 0.8rem 1rem;
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-input);
    font-family: inherit;
    font-size: 0.92rem;
    line-height: 1.75;
    white-space: pre-wrap;
    overflow-x: auto;
  }

  /* Classify ---------------------------------------------------------------- */

  .classify-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .classify-row {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-input);
    background: var(--color-paper);
    padding: 0.7rem 0.9rem;
  }

  .classify-text {
    margin: 0 0 0.5rem;
    line-height: 1.6;
  }

  .bin-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .bin-btn {
    border: 1px solid var(--color-border);
    background: var(--color-paper-2);
    color: var(--color-muted);
    border-radius: var(--radius-pill);
    padding: 0.35rem 0.85rem;
    font-family: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    transition: background-color 140ms var(--ease-out), border-color 140ms var(--ease-out), color 140ms var(--ease-out);
  }

  .bin-btn.selected {
    background: var(--color-accent-tint);
    border-color: var(--color-accent);
    color: var(--color-accent-hover);
  }

  /* Order ------------------------------------------------------------------- */

  .order-slots {
    margin: 0.25rem 0 0.25rem 1.5rem;
    padding: 0.5rem 0.75rem 0.5rem 2rem;
    border-left: 3px dashed var(--color-border);
    min-height: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .order-empty {
    list-style: none;
    margin-left: -1.5rem;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .pool-label {
    margin: 1rem 0 0.4rem;
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  .order-pool {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-height: 1rem;
  }

  .block-btn {
    text-align: left;
    border: 1px solid var(--color-accent);
    background: var(--color-accent-tint);
    color: var(--color-ink);
    border-radius: var(--radius-input);
    padding: 0.5rem 0.8rem;
    font-family: inherit;
    font-size: 0.92rem;
    cursor: pointer;
    transition: transform 140ms var(--ease-out);
  }

  .block-btn:active {
    transform: scale(0.98);
  }

  /* Tables ------------------------------------------------------------------ */

  .table-wrap {
    overflow-x: auto;
    margin: 0 0 1rem;
  }

  .trace-table,
  .ref-table {
    margin: 0 auto;
    border-collapse: collapse;
    font-size: 0.92rem;
  }

  .trace-table th,
  .trace-table td,
  .ref-table th,
  .ref-table td {
    border: 1px solid var(--color-border);
    padding: 0.4rem 0.6rem;
    text-align: center;
    vertical-align: middle;
  }

  .trace-table th,
  .ref-table th {
    color: var(--color-muted);
    font-weight: 600;
  }

  .trace-table .number-input {
    width: 3.5rem;
  }

  .trace-select {
    max-width: 9.5rem;
    background: var(--color-paper);
    color: var(--color-ink);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-input);
    padding: 0.35rem 0.4rem;
    font-family: inherit;
    font-size: 0.9rem;
  }

  /* Quiz -------------------------------------------------------------------- */

  .quiz-area {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .question-prompt {
    margin: 0 0 0.5rem;
    line-height: 1.7;
    font-weight: 600;
  }

  .question-no {
    margin-right: 0.35rem;
    color: var(--color-accent-hover);
  }

  .text-input {
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-input);
    color: var(--color-ink);
    padding: 0.5rem 0.7rem;
    font-family: inherit;
    font-size: 1rem;
  }

  .number-input {
    width: 6.5rem;
    max-width: 100%;
    text-align: center;
  }

  .choice-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .choice-list.stacked {
    flex-direction: column;
    align-items: stretch;
  }

  .choice-btn {
    text-align: left;
    border: 1px solid var(--color-border);
    background: var(--color-paper);
    color: var(--color-ink);
    border-radius: var(--radius-input);
    padding: 0.55rem 0.9rem;
    font-family: inherit;
    font-size: 0.95rem;
    line-height: 1.5;
    cursor: pointer;
    transition: background-color 140ms var(--ease-out), border-color 140ms var(--ease-out), transform 140ms var(--ease-out);
  }

  .choice-btn:active {
    transform: scale(0.98);
  }

  .choice-btn.selected {
    background: var(--color-accent-tint);
    border-color: var(--color-accent);
    color: var(--color-accent-hover);
  }

  /* Race widget ------------------------------------------------------------- */

  .race {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-paper);
    padding: 1rem;
  }

  .race-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .race-controls label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .race-status {
    min-height: 1.4em;
    margin: 0.6rem 0 0;
    font-size: 0.88rem;
    color: var(--color-wrong);
  }

  .race-lanes {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .race-lanes :global(.lane-head) {
    display: flex;
    justify-content: space-between;
    font-weight: 600;
    margin-bottom: 0.3rem;
  }

  .race-lanes :global(.lane-count) {
    color: var(--color-accent-hover);
  }

  .race-lanes :global(.lane-chips) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .race-lanes :global(.chip) {
    font-size: 0.8rem;
    padding: 0.1rem 0.4rem;
    border-radius: 6px;
    border: 1px solid var(--color-border);
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  .race-lanes :global(.chip.hit) {
    border-color: var(--color-correct);
    color: var(--color-correct);
    font-weight: 700;
  }

  .race-lanes :global(.chip.gap) {
    border-style: dashed;
  }

  /* Buttons & feedback ------------------------------------------------------ */

  .primary-btn {
    background: var(--color-accent);
    color: var(--color-paper);
    border: none;
    border-radius: var(--radius-pill);
    padding: 0.75rem 1.75rem;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 140ms var(--ease-out), transform 140ms var(--ease-out);
  }

  .primary-btn.small {
    padding: 0.5rem 1.2rem;
    font-size: 0.92rem;
  }

  .primary-btn:hover {
    background: var(--color-accent-hover);
  }

  .primary-btn:active {
    transform: scale(0.97);
  }

  .feedback {
    min-height: 1.4em;
    font-size: 0.95rem;
    line-height: 1.6;
    white-space: pre-line;
  }

  /* Outlines the specific rows/options/questions the feedback is talking about. */
  .answer-area :global(.is-wrong) {
    outline: 2px solid var(--color-wrong);
    outline-offset: 2px;
    border-radius: var(--radius-input);
  }

  .feedback.correct {
    color: var(--color-correct);
  }

  .feedback.wrong {
    color: var(--color-wrong);
  }

  .level-card.flash-correct {
    background: var(--color-correct-bg);
    transition: background-color 200ms var(--ease-out);
  }

  .level-card.shake {
    animation: shake-x 320ms var(--ease-in-out);
    background: var(--color-wrong-bg);
  }

  @keyframes shake-x {
    0%, 100% { transform: translateX(0); }
    20% { transform: translateX(-6px); }
    40% { transform: translateX(6px); }
    60% { transform: translateX(-4px); }
    80% { transform: translateX(4px); }
  }

  /* Finale (same stamp effect as the 特務闖關 page) ------------------------ */

  .finale-screen[hidden] {
    display: none;
  }

  .finale-screen {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    min-height: 20rem;
    justify-content: center;
  }

  .stamp-wrap {
    position: relative;
    width: 160px;
    height: 160px;
  }

  .stamp {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 4px solid var(--color-accent);
    color: var(--color-accent-hover);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: 0.1em;
    opacity: 0;
    transform: rotate(-2deg) scale(5);
  }

  .finale-screen.stamped .stamp {
    animation: stamp-slam 480ms cubic-bezier(0.6, 0.04, 0.98, 0.335) forwards;
  }

  @keyframes stamp-slam {
    0% { opacity: 0; transform: rotate(-2deg) scale(5); }
    10% { opacity: 0.6; transform: rotate(-2deg) scale(5); }
    100% { opacity: 1; transform: rotate(-8deg) scale(1); }
  }

  .stamp-impact {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 3px solid var(--color-accent);
    opacity: 0;
    pointer-events: none;
  }

  .finale-screen.stamped .stamp-impact {
    animation: stamp-ring 460ms var(--ease-out) 480ms both;
  }

  @keyframes stamp-ring {
    0% { opacity: 0; transform: scale(0.8); }
    15% { opacity: 0.9; transform: scale(0.95); }
    100% { opacity: 0; transform: scale(1.6); }
  }

  .stamp-glow {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in oklch, var(--color-accent) 55%, transparent) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 700ms var(--ease-out);
  }

  .finale-screen.stamped .stamp-glow {
    opacity: 1;
  }

  .finale-text {
    text-align: center;
  }

  .finale-line {
    line-height: 1.7;
  }

  .finale-hint {
    color: var(--color-muted);
  }

  .recap-link {
    color: var(--color-accent-hover);
    font-size: 0.9rem;
    text-decoration: underline;
  }

  @keyframes cursor-blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .level-card,
    .cipher-char,
    .choice-btn,
    .bin-btn,
    .block-btn,
    .primary-btn {
      transition-duration: 60ms !important;
    }

    .level-card.shake {
      animation: none;
    }

    .finale-screen.stamped .stamp {
      animation: none;
      opacity: 1;
      transform: rotate(-8deg) scale(1);
    }

    .stamp-impact {
      display: none;
    }
  }
</style>
