---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const items = (await getCollection('showcase')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="學生作品展示">
  <h1>學生作品展示</h1>
  <p>這裡展示班上同學做的作品,提供大家互相參考、觀摩學習。</p>
  <ul class="card-list">
    {items.map((item) => (
      <li class="card">
        <a href={`${base}showcase/${item.id}/`}>{item.data.title}</a>
        <p class="meta">
          {item.data.grade && <span class="tag">{item.data.grade} 年級</span>}
          {item.data.creditLabel && <span class="tag">{item.data.creditLabel}</span>}
          {item.data.date.toLocaleDateString('zh-TW')}
        </p>
        {item.data.description && <p class="meta">{item.data.description}</p>}
      </li>
    ))}
  </ul>
</BaseLayout>
