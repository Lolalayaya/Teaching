---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Embed from '../../components/Embed.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('showcase');
  return items.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

interface Props {
  item: CollectionEntry<'showcase'>;
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<BaseLayout title={item.data.title} description={item.data.description}>
  <p class="meta">
    {item.data.grade && <span class="tag">{item.data.grade} 年級</span>}
    {item.data.creditLabel && <span class="tag">{item.data.creditLabel}</span>}
    {item.data.date.toLocaleDateString('zh-TW')}
  </p>
  <h1>{item.data.title}</h1>
  <Content />

  {item.data.embeds?.map((embed) => (
    <Embed type={embed.type} title={embed.title} url={embed.url} />
  ))}
</BaseLayout>
