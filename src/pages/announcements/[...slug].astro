---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Embed from '../../components/Embed.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const announcements = await getCollection('announcements');
  return announcements.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'announcements'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title}>
  <p class="meta">
    <span class="tag">{post.data.category}</span>
    {post.data.date.toLocaleDateString('zh-TW')}
    {post.data.dueDate && ` · 截止日：${post.data.dueDate.toLocaleDateString('zh-TW')}`}
  </p>
  <h1>{post.data.title}</h1>
  <Content />

  {post.data.embeds?.map((embed) => (
    <Embed type={embed.type} title={embed.title} url={embed.url} />
  ))}
</BaseLayout>
