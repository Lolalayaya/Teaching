---
import Nav from '../components/Nav.astro';
import '../styles/global.css';
import { GRADES } from '../scripts/classOptions.js';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '柔雅老師的資訊柑仔店 · 國中資訊科技課程教材網站' } = Astro.props;

// /admin 有自己的密碼門（見 src/pages/admin/index.astro），不需要再套一層全站門。
const skipGate = Astro.url.pathname.includes('/admin');
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{title} | 柔雅老師的資訊柑仔店</title>
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('teaching-site:theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.setAttribute('data-theme', saved);
          }
        } catch (e) {}
      })();
      // 跟 src/scripts/siteGate.js 的 UNLOCK_KEY 要保持一致，這裡先同步設定
      // data-gate-state，避免解鎖後每次重新整理都閃一下鎖定畫面。
      (function () {
        try {
          var unlock = JSON.parse(localStorage.getItem('teaching-site:unlock') || 'null');
          if (unlock && (unlock.mode === 'class' || unlock.mode === 'teacher')) {
            document.documentElement.setAttribute('data-gate-state', 'unlocked');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    {skipGate ? (
      <Fragment>
        <Nav />
        <main>
          <slot />
        </main>
        <footer class="site-footer">
          <p>柔雅老師的資訊柑仔店 · 僅供本班學生課程學習使用</p>
        </footer>
      </Fragment>
    ) : (
      <Fragment>
        <section data-site-gate class="site-gate">
          <h1>請先確認班級</h1>
          <p>
            選擇你的年級／班級並輸入班級密碼才能進入網站；老師／管理者請直接輸入老師密碼，不用選班級。
          </p>
          <form class="class-picker" data-gate-form>
            <label>
              年級
              <select name="grade" data-gate-grade>
                <option value="" disabled selected>請選擇</option>
                {GRADES.map((g) => <option value={g}>{g} 年級</option>)}
              </select>
            </label>
            <label>
              班級
              <select name="cls" data-gate-class disabled>
                <option value="" disabled selected>請先選年級</option>
              </select>
            </label>
            <label>
              密碼
              <span class="password-field">
                <input type="password" name="password" data-gate-password autocomplete="off" required />
                <button type="button" class="password-toggle" data-toggle-password></button>
              </span>
            </label>
            <button type="submit">進入網站</button>
          </form>
          <p data-gate-error hidden class="site-gate-error">密碼不對，請確認班級或再跟老師確認一次密碼。</p>
        </section>

        <div data-site-shell>
          <Nav />
          <main>
            <slot />
          </main>
          <footer class="site-footer">
            <p>柔雅老師的資訊柑仔店 · 僅供本班學生課程學習使用</p>
          </footer>
        </div>

        <script>
          import { initSiteGate } from '../scripts/siteGate.js';
          import { initPasswordToggles } from '../scripts/passwordToggle.js';
          initSiteGate();
          initPasswordToggles();
        </script>
      </Fragment>
    )}
    <script>
      import { markExternalLinks } from '../scripts/externalLinks.js';
      markExternalLinks();
    </script>
  </body>
</html>

<style is:global>
  [data-site-gate] {
    display: none;
  }

  :root:not([data-gate-state='unlocked']) [data-site-shell] {
    display: none;
  }

  :root:not([data-gate-state='unlocked']) [data-site-gate] {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 32rem;
    margin: 3rem auto;
    padding: 0 1.5rem;
  }

  .site-gate-error {
    color: var(--color-wrong);
  }
</style>
